<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= blog?.title || 'Blog Detail' %> | Blogify</title>
  <%- include('./partials/header') %>
</head>
<body>
  <%- include('./partials/nav') %>
  <%- include('./partials/messages') %>
  <main class="container py-5">
    <div class="card shadow-sm mb-4">
      <% if (blog.coverImageUrl) { %>
        <img src="<%= blog.coverImageUrl %>" class="card-img-top mx-auto d-block" style="width: 100%; max-height: 420px; object-fit: cover;" alt="Cover Image">
      <% } %>
      <div class="card-body">
        <h1 class="mb-3"><%= blog.title %></h1>
        <div class="d-flex align-items-center mb-4">
          <img src="<%= blog.createdBy.profile %>" alt="profile" class="rounded-circle profile-avatar">
          <div class="ms-3">
            <p class="mb-1 text-muted">Posted by <strong><%= blog.createdBy.name %></strong></p>
            <small class="text-muted"><%= blog.createdBy.email || '' %></small>
          </div>
        </div>
        <p class="fs-5" style="white-space: pre-line;"><%= blog.content %></p>
      </div>
    </div>

    <section class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Comments</h3>
        <span class="text-muted"><%= comments.length %> <%= comments.length === 1 ? 'comment' : 'comments' %></span>
      </div>

      <% if (!comments || comments.length === 0) { %>
        <div class="alert alert-secondary">No comments yet. Be the first to share your thoughts.</div>
      <% } else { %>
        <% comments.forEach(comment => { %>
          <div class="card mb-3 shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-center mb-3">
                <img src="<%= comment.createdBy.profile %>" class="rounded-circle profile-avatar" alt="Commenter profile">
                <div class="ms-3">
                  <strong><%= comment.createdBy.name %></strong>
                  <div class="text-muted"><%= comment.createdAt.toDateString() %></div>
                </div>
              </div>
              <p class="mb-0"><%= comment.content %></p>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="card shadow-sm">
      <div class="card-body">
        <h3 class="mb-4">Add Comment</h3>
        <form action="/comment/<%= blog._id %>" method="POST">
          <div class="mb-3">
            <textarea class="form-control" rows="4" name="content" placeholder="Write your comment..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Post Comment</button>
        </form>
      </div>
    </section>
  </main>
  <%- include('./partials/script') %>
</body>
</html>