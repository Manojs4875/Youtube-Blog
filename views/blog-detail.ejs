<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <%- include('./partials/header') %>
</head>
</head>

<body>
    <%- include('./partials/nav') %>
        <%- include('./partials/script') %>
            <div class="container mt-5">

                <div class="card shadow">

                    <% if(blog.coverImageUrl){ %>

                        <img src="<%= blog.coverImageUrl %>" class="card-img-top mx-auto d-block"
                            style="width: 60%; height: 250px; object-fit: cover;" alt="Cover Image">

                        <% } %>

                            <div class="card-body">

                                <h1 class="mb-3">
                                    <%= blog.title %>
                                </h1>

                                <hr>

                                <div class="d-flex align-items-center mb-3">
                                    <img src="<%= blog.createdBy.profile %>" alt="profile" class="rounded-circle"
                                        style="width:50px; height:50px; object-fit:cover;">

                                    <div class="ms-3">
                                        <p class="mb-0 text-muted">
                                            Posted by
                                            <strong>
                                                <%= blog.createdBy.name %>
                                            </strong>
                                        </p>
                                    </div>

                                </div>

                                <p style="white-space: pre-line; font-size:18px;">
                                    <%= blog.content %>
                                </p>
                                <hr>

                                <hr>

                                <h3 class="mb-4">Comments</h3>

                                <% comments.forEach(comment=> { %>

                                    <div class="card mb-3">

                                        <div class="card-body">

                                            <div class="d-flex align-items-center mb-3">

                                                <img src="<%= comment.createdBy.profile %>" class="rounded-circle"
                                                    style="width:45px;height:45px;object-fit:cover;">

                                                <div class="ms-3">

                                                    <strong>
                                                        <%= comment.createdBy.name %>
                                                    </strong>

                                                    <div class="text-muted">
                                                        <%= comment.createdAt.toDateString() %>
                                                    </div>

                                                </div>

                                            </div>

                                            <p class="mb-0">
                                                <%= comment.content %>
                                            </p>

                                        </div>

                                    </div>

                                    <% }) %>
                                        <div class="mt-5">

                                            <h3>Add Comment</h3>

                                            <form action="/comment/<%= blog._id %>" method="POST">

                                                <div class="mb-3">
                                                    <textarea class="form-control" rows="4" name="content"
                                                        placeholder="Write your comment..." required></textarea>
                                                </div>

                                                <button class="btn btn-primary">
                                                    Post Comment
                                                </button>

                                            </form>

                                        </div>

                            </div>

                </div>


</body>

</html>