<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Blogs | Blogify</title>
  <%- include('./partials/header') %>
</head>
<body>
  <%- include('./partials/nav') %>
  <%- include('./partials/messages') %>
  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">All Blogs</h1>
        <p class="text-muted">Browse published stories from the community.</p>
      </div>
      <a href="/blog" class="btn btn-primary">Publish a blog</a>
    </div>

    <% if (!blogs || blogs.length === 0) { %>
      <div class="alert alert-secondary">No blogs available yet. Start by publishing your first post.</div>
    <% } else { %>
      <div class="row gy-4">
        <% blogs.forEach(blog => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <% if (blog.coverImageUrl) { %>
                <img src="<%= blog.coverImageUrl %>" class="card-img-top blog-image" alt="Blog cover image">
              <% } %>
              <div class="card-body">
                <h5 class="card-title"><%= blog.title %></h5>
                <p class="card-text text-truncate" style="max-height:5rem;">
                  <%= blog.content.length > 120 ? blog.content.substring(0, 120) + '...' : blog.content %>
                </p>
                <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary">Read More</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
  <%- include('./partials/script') %>
</body>
</html>