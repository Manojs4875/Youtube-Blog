<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Blog | Blogify</title>
  <%- include('./partials/header') %>
</head>
<body>
  <%- include('./partials/nav') %>
  <%- include('./partials/messages') %>
  <main class="container py-5">
    <div class="card shadow-sm">
      <div class="card-body p-5">
        <h2 class="mb-4 text-center">Create New Blog</h2>
        <form action="/blog" method="POST" enctype="multipart/form-data" novalidate>
          <div class="mb-3">
            <label class="form-label">Cover Image</label>
            <input type="file" class="form-control" name="coverImageUrl" accept="image/*">
          </div>
          <div class="mb-3">
            <label class="form-label">Blog Title</label>
            <input type="text" class="form-control" name="title" placeholder="Enter blog title" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Blog Content</label>
            <textarea class="form-control" name="content" rows="10" placeholder="Write your blog here..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100">Publish Blog</button>
        </form>
      </div>
    </div>
  </main>
  <%- include('./partials/script') %>
</body>
</html>